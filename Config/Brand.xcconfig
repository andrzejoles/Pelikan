// Nazwa aplikacji i bundle id — JEDYNE miejsce, w którym je zmieniasz.
// Kod czyta nazwę z Info.plist (klucz PelikanAppName), katalog danych to ~/Library/Application Support/$(PELIKAN_APP_NAME).
PELIKAN_APP_NAME = Pelikan
PRODUCT_NAME = $(PELIKAN_APP_NAME)
PRODUCT_BUNDLE_IDENTIFIER = local.aoles.pelikan
// Wersja i numer kompilacji z historii gita (scripts/set-version.sh → build/Version.xcconfig) — tu wartości zastępcze.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
PELIKAN_COPYRIGHT = © 2026 Andrzej Oleś w kooperacji z Claude AI
// Repozytorium wydań i kanał aktualizacji Sparkle (`//` w xcconfig to komentarz, stąd `/$()/`).
PELIKAN_REPOSITORY = andrzejoles/Pelikan
PELIKAN_UPDATE_FEED_URL = https:/$()/github.com/$(PELIKAN_REPOSITORY)/releases/latest/download/appcast.xml
DEVELOPMENT_TEAM =

// Wygenerowane przed budowaniem przez scripts/set-version.sh (poza repozytorium).
#include? "../build/Version.xcconfig"
