<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bez sandboxa: Instant Client ładowany z katalogu użytkownika (dlopen), TNS_ADMIN i wallety w dowolnych
	     katalogach, ssh dla tuneli, CLI agentów w terminalu (jak Bifold). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened Runtime z wyłączoną tylko walidacją bibliotek: Instant Client (dlopen z katalogu użytkownika) jest
	     podpisany przez Oracle, nie certyfikatem Pelikana. Blokada zmiennych DYLD_* i podłączania procesów zostaje —
	     bez allow-dyld-environment-variables i get-task-allow (to drugie Xcode dodaje sam tylko w Debug). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
