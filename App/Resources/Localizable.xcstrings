        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra u oculta la cuadrícula de 8 px y el ajuste a ella."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet das 8-px-Raster und das Einrasten daran ein oder aus."
          }
        }
      }
    },
    "Pokazuje lub ukrywa w edytorach spacje, tabulacje i końce linii." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows or hides spaces, tabs and line ends in editors."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt oder verbirgt Leerzeichen, Tabulatoren und Zeilenenden in Editoren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra u oculta espacios, tabulaciones y finales de línea en los editores."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує або приховує в редакторах пробіли, табуляції та кінці рядків."
          }
        }
      }
    },
    "Pokazuje menedżer celów SSH zdalnego builda Pro*C: drzewo z folderami, dodawanie, edycja, duplikowanie i usuwanie celów, środowisko UAT/PROD." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the SSH target manager for the Pro*C remote build: tree with folders, adding, editing, duplicating and deleting targets, UAT/PROD environment."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує менеджер цілей SSH віддаленої збірки Pro*C: дерево з папками, додавання, редагування, дублювання й видалення цілей, середовище UAT/PROD."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el gestor de destinos SSH del build remoto de Pro*C: árbol con carpetas; añadir, editar, duplicar y eliminar destinos; entorno UAT/PROD."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Verwaltung der SSH-Ziele für den Pro*C-Remote-Build: Baum mit Ordnern, Hinzufügen, Bearbeiten, Duplizieren und Löschen von Zielen, Umgebung UAT/PROD."
          }
        }
      }
    },
    "Pokazuje pod siatką sumę, liczbę, średnią, minimum lub maksimum kolumny; ustawienie zostaje po ponownym wykonaniu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the column sum, count, average, minimum or maximum below the grid; the setting is kept after re-execution."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt unter dem Raster Summe, Anzahl, Durchschnitt, Minimum oder Maximum der Spalte; die Einstellung bleibt nach erneuter Ausführung erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra bajo la cuadrícula la suma, el recuento, la media, el mínimo o el máximo de la columna; el ajuste se conserva tras volver a ejecutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує під таблицею суму, кількість, середнє, мінімум або максимум стовпця; налаштування зберігається після повторного виконання."
          }
        }
      }
    },
    "Pokazuje raport zapisanego przebiegu profilera w karcie Profiler okna testu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the report of a saved profiler run in the Profiler tab of the Test Window."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Bericht eines gespeicherten Profiler-Laufs im Profiler-Tab des Testfensters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el informe de una ejecución guardada del profiler en la pestaña Profiler de la ventana de prueba."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує звіт збереженого запуску профайлера на вкладці Профайлер вікна тесту."
          }
        }
      }
    },
    "Pokazuje tylko kolumny pasujące do nazw, typów, obowiązkowości i kluczy; lista nazw może być wklejona." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows only columns matching names, types, mandatory status and keys; the name list can be pasted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur Spalten, die zu Namen, Typen, Pflichtangabe und Schlüsseln passen; die Namensliste kann eingefügt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra solo las columnas que coinciden con nombres, tipos, obligatoriedad y claves; la lista de nombres se puede pegar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує лише стовпці, що відповідають назвам, типам, обов’язковості й ключам; список назв можна вставити."
          }
        }
      }
    },
    "Pokazuje tylko wiersze z wartością bieżącej komórki w jej kolumnie (albo wszystkie poza nią) — lokalnie, bez ponownego zapytania." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows only rows with the current cell's value in its column (or all except it) — locally, without re-querying."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує лише рядки зі значенням поточної клітинки в її стовпці (або всі, крім неї) — локально, без повторного запиту."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra solo las filas con el valor de la celda actual en su columna (o todas salvo esas), localmente, sin repetir la consulta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur Zeilen mit dem Wert der aktuellen Zelle in ihrer Spalte (oder alle außer diesen) — lokal, ohne erneute Abfrage."
          }
        }
      }
    },
