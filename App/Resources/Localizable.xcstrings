    "%%1 i %%2 — pliki lewy i prawy, %%3 i %%4 — ich tytuły. Program jest uruchamiany bez powłoki; argumenty rozdziela spacja, cudzysłów grupuje." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%1 and %%2 — left and right files, %%3 and %%4 — their titles. The program runs without a shell; arguments are separated by spaces and grouped by quotes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%1 und %%2 – linke und rechte Datei, %%3 und %%4 – ihre Titel. Das Programm wird ohne Shell gestartet; Argumente werden durch Leerzeichen getrennt und durch Anführungszeichen gruppiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%1 y %%2: archivos izquierdo y derecho; %%3 y %%4: sus títulos. El programa se ejecuta sin shell; los argumentos se separan con espacios y se agrupan con comillas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%1 і %%2 — лівий і правий файли, %%3 і %%4 — їхні заголовки. Програма запускається без оболонки; аргументи розділяє пробіл, лапки групують."
          }
        }
      }
    },
    "%%s zastępuje zaznaczony tekst albo słowo pod kursorem; dozwolone tylko adresy http i https." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%s is replaced by the selected text or the word at the cursor; only http and https addresses are allowed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%s wird durch den ausgewählten Text oder das Wort an der Einfügemarke ersetzt; nur http- und https-Adressen sind erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%s se sustituye por el texto seleccionado o la palabra bajo el cursor; solo se permiten direcciones http y https."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%s замінюється виділеним текстом або словом під курсором; дозволені лише адреси http і https."
