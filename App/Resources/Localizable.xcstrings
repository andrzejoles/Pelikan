    "Uruchamia %@ w panelu agenta z serwerem MCP Pelikana tylko dla tej sesji; najpierw macierz uprawnień sesji." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launches %@ in the agent panel with Pelikan's MCP server for this session only; first the session permission matrix."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускає %@ на панелі агента із сервером MCP Pelikan лише для цього сеансу; спершу матриця дозволів сеансу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta %@ en el panel del agente con el servidor MCP de Pelikan solo para esta sesión; primero, la matriz de permisos de la sesión."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet %@ im Agentenbereich mit dem MCP-Server von Pelikan nur für diese Sitzung; zuerst die Berechtigungsmatrix der Sitzung."
          }
        }
      }
    },
    "Uruchamia ponownie testy nieudane w ostatnim przebiegu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reruns the tests that failed in the last run."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно запускає тести, що не вдалися в останньому запуску."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ejecutar las pruebas fallidas en la última ejecución."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt die im letzten Lauf fehlgeschlagenen Tests erneut aus."
          }
        }
      }
    },
    "Uruchamia program „%@” ze zmiennymi bieżącego okna i obiektu (bez danych logowania)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs program “%@” with the variables of the current window and object (without login credentials)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускає програму «%@» зі змінними поточного вікна й об'єкта (без облікових даних)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta el programa «%@» con las variables de la ventana y el objeto actuales (sin credenciales)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet das Programm „%@“ mit Variablen des aktuellen Fensters und Objekts (ohne Anmeldedaten)."
          }
        }
      }
    },
    "Uruchamia skrypt okna testu z debugerem i zatrzymuje się w pierwszej linii." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs the Test Window script with the debugger and stops at the first line."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускає скрипт Test Window з налагоджувачем і зупиняється на першому рядку."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta el script de la Test Window con el depurador y se detiene en la primera línea."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt das Skript des Test Window mit Debugger aus und hält in der ersten Zeile an."
          }
        }
      }
    },
    "Uruchamia test (procedurę pod kursorem) albo cały pakiet testowy z okna programu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs the test (procedure under the cursor) or the entire test package from the Program Window."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускає тест (процедуру під курсором) або весь тестовий пакет із Program Window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta la prueba (el procedimiento bajo el cursor) o todo el paquete de pruebas desde la Program Window."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt den Test (Prozedur unter dem Cursor) oder das ganze Testpaket aus dem Program Window aus."
          }
        }
      }
    },
    "Uruchamia testy utPLSQL w sesjach agenta (zmiany testów są wycofywane przez utPLSQL) i zwraca wynik po zakończeniu; okno wyników pokazuje przebieg użytkownikowi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs utPLSQL tests in the agent's sessions (test changes are rolled back by utPLSQL) and returns the result on completion; the results window shows the run to the user."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускає тести utPLSQL у сеансах агента (зміни тестів відкочує utPLSQL) і повертає результат після завершення; вікно результатів показує перебіг користувачеві."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta las pruebas utPLSQL en las sesiones del agente (utPLSQL revierte los cambios de las pruebas) y devuelve el resultado al terminar; la ventana de resultados muestra la ejecución al usuario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt utPLSQL-Tests in Agentensitzungen aus (Teständerungen werden von utPLSQL zurückgerollt) und gibt das Ergebnis nach Abschluss zurück; das Ergebnisfenster zeigt dem Benutzer den Ablauf."
          }
        }
      }
    },
    "Uruchamia testy utPLSQL; wynik JUnit w utplsql-junit.xml. Hasło: pytanie SQLcl/SQL*Plus albo wallet — nigdy w skrypcie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs utPLSQL tests; JUnit output in utplsql-junit.xml. Password: SQLcl/SQL*Plus prompt or wallet — never in the script."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускає тести utPLSQL; результат JUnit в utplsql-junit.xml. Пароль: запит SQLcl/SQL*Plus або wallet — ніколи в скрипті."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta las pruebas utPLSQL; resultado JUnit en utplsql-junit.xml. Contraseña: la pide SQLcl/SQL*Plus o wallet; nunca en el script."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt utPLSQL-Tests aus; JUnit-Ergebnis in utplsql-junit.xml. Passwort: Abfrage durch SQLcl/SQL*Plus oder Wallet — niemals im Skript."
          }
        }
      }
    },
    "Uruchamia testy z pokryciem kodu bieżącego schematu: raport HTML i linie pokryte na marginesie edytora. Pokrycie zbiera dane profilera." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs tests with code coverage of the current schema: HTML report and covered lines in the editor margin. Coverage collects profiler data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускає тести з покриттям коду поточної схеми: звіт HTML і покриті рядки на полі редактора. Покриття збирає дані профайлера."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta las pruebas con cobertura de código del esquema actual: informe HTML y líneas cubiertas en el margen del editor. La cobertura recoge datos del profiler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
