    "Stop: kończy ssh -tt (SIGHUP po stronie serwera) i zapasowo zabija grupę procesów skryptu; blokada zdejmowana." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop: terminates ssh -tt (SIGHUP on the server side) and, as a fallback, kills the script's process group; the lock is released."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стоп: завершує ssh -tt (SIGHUP на боці сервера) і запасно вбиває групу процесів скрипту; блокування знімається."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener: finaliza ssh -tt (SIGHUP en el servidor) y, como reserva, mata el grupo de procesos del script; se libera el bloqueo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopp: beendet ssh -tt (SIGHUP auf Serverseite) und beendet ersatzweise die Prozessgruppe des Skripts; die Sperre wird aufgehoben."
          }
        }
      }
    },
