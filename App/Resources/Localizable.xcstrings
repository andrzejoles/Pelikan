    "Licencja Oracle %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oracle license %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ліцензія Oracle %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licencia de Oracle %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oracle-Lizenz %@"
          }
        }
      }
    },
    "Licencja Oracle nie pozwala dołączyć Instant Client do Pelikana. Bez niego możesz użyć sterownika „thin” (Definicja połączenia › Ogólne › Sterownik) — z ograniczeniami: bez TCPS/wallet, Kerberos i przerwania wykonania." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Oracle license does not allow Instant Client to be bundled with Pelikan. Without it you can use the “thin” driver (Connection definition › General › Driver) — with limitations: no TCPS/wallet, Kerberos or execution break."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Oracle-Lizenz erlaubt nicht, Instant Client mit Pelikan auszuliefern. Ohne ihn kann der „Thin“-Treiber verwendet werden (Verbindungsdefinition › Allgemein › Treiber) — mit Einschränkungen: ohne TCPS/Wallet, Kerberos und Abbruch der Ausführung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licencia de Oracle no permite incluir Instant Client en Pelikan. Sin él puede usar el controlador «thin» (Definición de conexión › General › Controlador), con limitaciones: sin TCPS/wallet, Kerberos ni interrupción de la ejecución."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ліцензія Oracle не дозволяє долучити Instant Client до Pelikan. Без нього можна використати драйвер «thin» (Визначення з'єднання › Загальні › Драйвер) — з обмеженнями: без TCPS/wallet, Kerberos і переривання виконання."
          }
        }
      }
    },
