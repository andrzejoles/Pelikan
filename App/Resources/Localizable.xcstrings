    "INSERT, UPDATE, DELETE albo MERGE dla zaznaczonych wierszy (klucz z klucza głównego tabeli albo ROWID) w nowym oknie SQL, bez wykonania." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "INSERT, UPDATE, DELETE or MERGE for the selected rows (key from the table's primary key or ROWID) in a new SQL Window, not executed."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "INSERT, UPDATE, DELETE або MERGE для вибраних рядків (ключ із первинного ключа таблиці або ROWID) у новому SQL Window, без виконання."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "INSERT, UPDATE, DELETE o MERGE para las filas seleccionadas (clave a partir de la clave primaria de la tabla o ROWID) en una nueva SQL Window, sin ejecutar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "INSERT, UPDATE, DELETE oder MERGE für die ausgewählten Zeilen (Schlüssel aus dem Primärschlüssel der Tabelle oder ROWID) in einem neuen SQL Window, ohne Ausführung."
          }
        }
      }
    },
    "INTERVAL (np. NUMTOYMINTERVAL(1,'MONTH'))" : {
      "localizations" : {
        "en" : {
