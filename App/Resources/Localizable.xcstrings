    "Kończy proces CLI, unieważnia token sesji, wycofuje niezatwierdzone zmiany agenta i zamyka jego sesje bazy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminates the CLI process, invalidates the session token, rolls back the agent's uncommitted changes and closes its database sessions."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершує процес CLI, анулює токен сеансу, відкочує незафіксовані зміни агента й закриває його сеанси бази."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finaliza el proceso CLI, invalida el token de sesión, revierte los cambios sin confirmar del agente y cierra sus sesiones de base de datos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet den CLI-Prozess, macht das Sitzungstoken ungültig, rollt nicht festgeschriebene Änderungen des Agenten zurück und schließt seine Datenbanksitzungen."
          }
        }
      }
    },
    "Kończy sesję bazy okna, gdy Przerwij nie działa." : {
      "localizations" : {
        "en" : {
