    "Odrzuca zmiany okien od ostatniego zapisu workseta i przywraca zapisany stan (po potwierdzeniu)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discards window changes since the workset was last saved and restores the saved state (after confirmation)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкидає зміни вікон від останнього збереження Workset і відновлює збережений стан (після підтвердження)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarta los cambios de las ventanas desde el último guardado del workset y restaura el estado guardado (tras confirmación)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwirft Fensteränderungen seit dem letzten Speichern des Worksets und stellt den gespeicherten Zustand wieder her (nach Bestätigung)."
          }
        }
      }
    },
    "Odrzuca zmiany okna: przywraca tekst z chwili otwarcia, wczytania z bazy albo zapisu (albo ponownie wczytuje źródło jednostek z bazy)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discards window changes: restores the text from when it was opened, loaded from the database or saved (or reloads the units' source from the database)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwirft Änderungen im Fenster: stellt den Text vom Öffnen, Laden aus der Datenbank oder Speichern wieder her (oder lädt die Quelle der Einheiten erneut aus der Datenbank)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarta los cambios de la ventana: restaura el texto del momento de abrirla, cargarla desde la base de datos o guardarla (o vuelve a cargar el código de las unidades desde la base de datos)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скасовує зміни у вікні: відновлює текст на момент відкриття, завантаження з бази або збереження (або повторно завантажує джерело одиниць із бази)."
          }
        }
      }
    },
