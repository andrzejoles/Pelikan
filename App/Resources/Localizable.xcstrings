    "Ręczne zdjęcie blokady wdrożenia na serwerze (np. po awarii) — pokazuje, kto ją trzyma, i wymaga potwierdzenia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manual release of the deployment lock on the server (e.g. after a failure) — shows who holds it and requires confirmation."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ручне зняття блокування розгортання на сервері (напр., після збою) — показує, хто його тримає, і потребує підтвердження."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberación manual del bloqueo de despliegue en el servidor (p. ej., tras un fallo): muestra quién lo tiene y requiere confirmación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuelles Aufheben der Deployment-Sperre auf dem Server (z. B. nach einem Absturz) — zeigt, wer sie hält, und erfordert Bestätigung."
          }
        }
      }
    },
