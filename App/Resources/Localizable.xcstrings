    "Trwale usuwa obiekt z kosza albo cały kosz użytkownika (PURGE) — po potwierdzeniu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently removes an object from the Recycle Bin or the user's entire Recycle Bin (PURGE) — after confirmation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt ein Objekt aus dem Papierkorb oder den gesamten Papierkorb des Benutzers endgültig (PURGE) — nach Bestätigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de forma permanente un objeto de la papelera de reciclaje o toda la papelera del usuario (PURGE), tras confirmación."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаточно видаляє об’єкт із кошика або весь кошик користувача (PURGE) — після підтвердження."
          }
        }
      }
    },
