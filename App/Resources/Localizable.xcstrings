    "Jawnie zmienia kodowanie, w którym okno zostanie zapisane (UTF-8, ISO-8859-2, Windows-1250); znaki spoza kodowania są wskazywane." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicitly changes the encoding in which the window will be saved (UTF-8, ISO-8859-2, Windows-1250); characters outside the encoding are indicated."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Явно змінює кодування, у якому буде збережено вікно (UTF-8, ISO-8859-2, Windows-1250); символи поза кодуванням позначаються."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia explícitamente la codificación con la que se guardará la ventana (UTF-8, ISO-8859-2, Windows-1250); se señalan los caracteres que no caben en la codificación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert ausdrücklich die Kodierung, in der das Fenster gespeichert wird (UTF-8, ISO-8859-2, Windows-1250); Zeichen außerhalb der Kodierung werden angezeigt."
          }
        }
      }
    },
