    "Zatwierdza niezatwierdzone zmiany agenta na połączeniu (po zgodzie z liczbą zmienionych wierszy) — nieodwracalne." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commits the agent's uncommitted changes on the connection (after consent showing the number of changed rows) — irreversible."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фіксує незафіксовані зміни агента на з'єднанні (після згоди з кількістю змінених рядків) — незворотно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma los cambios sin confirmar del agente en la conexión (tras una autorización que indica el número de filas modificadas); irreversible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt nicht festgeschriebene Änderungen des Agenten auf der Verbindung fest (nach Zustimmung mit Anzahl geänderter Zeilen) — unumkehrbar."
          }
        }
      }
    },
