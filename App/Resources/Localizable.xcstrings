          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung verloren — der nächste Befehl verbindet sich erneut."
          }
        }
      }
    },
    "Połączenie utracone: %@. Niezatwierdzone zmiany zostały wycofane przez serwer. Kolejne polecenie połączy się ponownie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection lost: %@. Uncommitted changes were rolled back by the server. The next statement will reconnect."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З'єднання втрачено: %@. Незафіксовані зміни відкочено сервером. Наступна команда під'єднається знову."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión perdida: %@. El servidor ha revertido los cambios sin confirmar. La siguiente sentencia volverá a conectar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung verloren: %@. Nicht festgeschriebene Änderungen wurden vom Server zurückgerollt. Der nächste Befehl verbindet sich erneut."
          }
        }
      }
    },
