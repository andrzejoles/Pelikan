    "Dodaje kursor w linii poniżej (w tej samej kolumnie); pisanie trafia do wszystkich kursorów." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a cursor on the line below (same column); typing goes to all cursors."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt in der Zeile darunter einen Cursor hinzu (gleiche Spalte); Eingaben gehen an alle Cursor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un cursor en la línea de abajo (misma columna); lo que escribes va a todos los cursores."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає курсор у рядку нижче (у тому самому стовпці); введення потрапляє до всіх курсорів."
          }
        }
      }
    },
