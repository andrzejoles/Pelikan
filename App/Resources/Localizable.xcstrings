          }
        }
      }
    },
    "Przenosi przypisanie „zmienna := wyrażenie;” z początku ciała do deklaracji zmiennej." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the assignment “variable := expression;” from the start of the body into the variable declaration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Zuweisung „Variable := Ausdruck;“ vom Anfang des Rumpfs in die Variablendeklaration."
