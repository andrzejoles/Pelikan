    "Kompiluje jednostki okna pod tymczasową nazwą i pokazuje błędy bez zastępowania obiektów w bazie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compiles the window's units under a temporary name and shows errors without replacing objects in the database."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiliert die Einheiten des Fensters unter einem temporären Namen und zeigt Fehler an, ohne Objekte in der Datenbank zu ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila las unidades de la ventana con un nombre temporal y muestra los errores sin reemplazar objetos en la base de datos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компілює одиниці вікна під тимчасовою назвою та показує помилки, не замінюючи об’єкти в базі даних."
          }
        }
      }
    },
    "Kompiluje jednostki z okna programu w sesji agenta (kod poprzedni trafia do historii) albo rekompiluje obiekt; zwraca błędy kompilacji." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compiles the units from the Program Window in the agent session (the previous code goes to history) or recompiles the object; returns compilation errors."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компілює одиниці з Program Window у сеансі агента (попередній код потрапляє до історії) або перекомпільовує об'єкт; повертає помилки компіляції."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila las unidades de la Program Window en la sesión del agente (el código anterior pasa al historial) o recompila el objeto; devuelve los errores de compilación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiliert Einheiten aus dem Program Window in der Agentensitzung (der vorherige Code kommt in den Verlauf) oder rekompiliert ein Objekt; gibt Kompilierungsfehler zurück."
          }
        }
      }
    },
    "Kompiluje jednostkę PL/SQL z informacją debugowania (ALTER … COMPILE DEBUG), także ciało pakietu/typu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compiles a PL/SQL unit with debug information (ALTER … COMPILE DEBUG), including the package/type body."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компілює одиницю PL/SQL з налагоджувальною інформацією (ALTER … COMPILE DEBUG), також тіло пакета/типу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila la unidad PL/SQL con información de depuración (ALTER … COMPILE DEBUG), también el cuerpo del paquete o tipo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiliert eine PL/SQL-Einheit mit Debug-Informationen (ALTER … COMPILE DEBUG), auch Package/Type Body."
          }
        }
      }
    },
    "Kompiluje obiekt ponownie (ALTER … COMPILE) w sesji kompilacji." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recompiles the object (ALTER … COMPILE) in the compilation session."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно компілює об'єкт (ALTER … COMPILE) у сеансі компіляції."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a compilar el objeto (ALTER … COMPILE) en la sesión de compilación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiliert das Objekt erneut (ALTER … COMPILE) in der Kompilierungssitzung."
          }
        }
      }
    },
    "Kompiluje ponownie zaznaczone obiekty; zwraca te, które pozostały nieprawidłowe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recompiles the selected objects; returns those that remain invalid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiliert die ausgewählten Objekte neu; gibt die weiterhin ungültigen zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recompila los objetos seleccionados; devuelve los que siguen siendo no válidos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно компілює вибрані об’єкти; повертає ті, що лишилися недійсними."
          }
        }
      }
    },
    "Kompiluje tylko pliki zmienione od ostatniego budowania i obiekty niepoprawne." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compiles only the files changed since the last build and invalid objects."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компілює лише файли, змінені після останньої збірки, і недійсні об'єкти."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila solo los archivos modificados desde el último build y los objetos no válidos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompiliert nur seit dem letzten Build geänderte Dateien und ungültige Objekte."
          }
        }
      }
    },
    "Kompiluje w bazie pakiet testowy utPLSQL podany przez agenta (specyfikacja z --%%suite i ciało)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
