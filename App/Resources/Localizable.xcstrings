    "Otwiera szablony kodu w osobnym, pływającym oknie (odłączone od paska bocznego)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the code templates in a separate floating window (undocked from the sidebar)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Codevorlagen in einem separaten, schwebenden Fenster (von der Seitenleiste gelöst)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre las plantillas de código en una ventana flotante independiente (desacoplada de la barra lateral)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває шаблони коду в окремому плаваючому вікні (від’єднаному від бічної панелі)."
          }
        }
      }
    },
    "Otwiera tekst okna w programie z Preferencji (np. Visual Studio Code); po powrocie do Pelikana zmiany są wczytywane." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the window text in the app set in Preferences (e.g. Visual Studio Code); changes are loaded when you return to Pelikan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet den Fenstertext in der App aus den Einstellungen (z. B. Visual Studio Code); bei der Rückkehr zu Pelikan werden Änderungen geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el texto de la ventana en la aplicación de Preferencias (p. ej., Visual Studio Code); al volver a Pelikan se cargan los cambios."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває текст вікна в програмі з Параметрів (напр. Visual Studio Code); після повернення до Pelikan зміни завантажуються."
          }
        }
      }
    },
    "Otwiera treść w programie skojarzonym z formatem; zapis w tym programie wraca do edytora" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the content in the application associated with the format; saving in that application returns it to the editor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває вміст у програмі, пов'язаній із форматом; збереження в цій програмі повертається в редактор"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el contenido en el programa asociado al formato; al guardar en ese programa vuelve al editor"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet den Inhalt im mit dem Format verknüpften Programm; Speichern in diesem Programm überträgt in den Editor zurück"
          }
        }
      }
    },
    "Otwiera w przeglądarce wyszukiwanie zaznaczonego tekstu albo słowa pod kursorem (wyszukiwania z %%s w Preferencjach)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a browser search for the selected text or the word at the cursor (searches with %%s in Preferences)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet im Browser eine Suche nach dem ausgewählten Text oder dem Wort an der Einfügemarke (Suchen mit %%s in den Einstellungen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre en el navegador una búsqueda del texto seleccionado o de la palabra bajo el cursor (búsquedas con %%s en Preferencias)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває в браузері пошук виділеного тексту або слова під курсором (пошуки з %%s у Параметрах)."
          }
        }
      }
    },
    "Otwiera widok w edytorze formularza (zapytanie, FORCE, READ ONLY, CHECK OPTION, komentarz) z podglądem DDL." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the view in a form editor (query, FORCE, READ ONLY, CHECK OPTION, comment) with a DDL preview."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Sicht in einem Formulareditor (Abfrage, FORCE, READ ONLY, CHECK OPTION, Kommentar) mit DDL-Vorschau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la vista en un editor de formulario (consulta, FORCE, READ ONLY, CHECK OPTION, comentario) con vista previa del DDL."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває подання в редакторі форми (запит, FORCE, READ ONLY, CHECK OPTION, коментар) з попереднім переглядом DDL."
          }
        }
      }
    },
    "Otwiera zaznaczony blok PL/SQL (albo całe okno) w oknie testu i wykonuje go z DBMS_OUTPUT." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the selected PL/SQL block (or the whole window) in a Test Window and runs it with DBMS_OUTPUT."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet den markierten PL/SQL-Block (oder das ganze Fenster) in einem Test Window und führt ihn mit DBMS_OUTPUT aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el bloque PL/SQL seleccionado (o toda la ventana) en un Test Window y lo ejecuta con DBMS_OUTPUT."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває виділений блок PL/SQL (або все вікно) у Test Window і виконує його з DBMS_OUTPUT."
          }
        }
      }
    },
    "Otwiera źródło programu (albo DDL innego obiektu) w nowym oknie, bez kompilacji; cofnięcie sesji agenta zamyka okno." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the program source (or the DDL of another object) in a new window, without compiling; reverting the agent session closes the window."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває джерело програми (або DDL іншого об'єкта) в новому вікні, без компіляції; скасування сеансу агента закриває вікно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el código fuente del programa (o el DDL de otro objeto) en una ventana nueva, sin compilar; al deshacer la sesión del agente se cierra la ventana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Programmquelle (oder DDL eines anderen Objekts) in einem neuen Fenster, ohne Kompilierung; Rückgängigmachen der Agentensitzung schließt das Fenster."
          }
        }
      }
    },
