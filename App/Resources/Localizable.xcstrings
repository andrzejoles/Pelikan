    "Zwija blok, IF, LOOP albo CASE zaczynający się w linii kursora lub najbliższy obejmujący kursor." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folds the block, IF, LOOP or CASE starting on the cursor line or the nearest one enclosing the cursor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Згортає блок, IF, LOOP чи CASE, що починається в рядку курсора, або найближчий, що містить курсор."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrae el bloque, IF, LOOP o CASE que empieza en la línea del cursor o el más cercano que contiene el cursor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klappt den Block, IF, LOOP oder CASE ein, der in der Cursorzeile beginnt, oder den nächsten, der den Cursor umschließt."
          }
        }
      }
    },
    "Zwija wszystkie bloki podprogramów i struktur sterujących." : {
      "localizations" : {
