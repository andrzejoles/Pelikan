    },
    "Dodaje obiekt bazy do koszyka wdrożenia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a database object to the deployment cart."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає об'єкт бази до кошика розгортання."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un objeto de la base de datos a la cesta de despliegue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt ein Datenbankobjekt in den Deployment-Korb."
          }
        }
      }
    },
    "Dodaje obiekt do aktywnego diagramu (albo nowego): tabele i widoki z kolumnami, linie kluczy obcych do obiektów na diagramie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the object to the active diagram (or a new one): tables and views with columns, foreign key lines to objects on the diagram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає об'єкт до активної діаграми (або нової): таблиці й подання зі стовпцями, лінії зовнішніх ключів до об'єктів на діаграмі."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el objeto al diagrama activo (o a uno nuevo): tablas y vistas con columnas, líneas de claves ajenas hacia los objetos del diagrama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt das Objekt dem aktiven (oder einem neuen) Diagramm hinzu: Tabellen und Views mit Spalten, Fremdschlüssellinien zu Objekten im Diagramm."
          }
        }
      }
    },
    "Dodaje obiekt zaznaczony w przeglądarce obiektów do projektu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the object selected in the Object Browser to the project."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає об'єкт, вибраний в Object Browser, до проєкту."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade al proyecto el objeto seleccionado en el Object Browser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt das im Object Browser ausgewählte Objekt zum Projekt hinzu."
          }
        }
      }
    },
    "Dodaje obiekty, od których zaznaczone zależą (ALL_DEPENDENCIES), i linie referencji." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
