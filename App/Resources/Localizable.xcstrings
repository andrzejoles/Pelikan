    "Porównuje DDL obiektów schematu ze schematem docelowym (także na innym połączeniu); lista różnic, podgląd i SQL wyrównujący." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares the DDL of schema objects with the target schema (also on another connection); list of differences, preview and synchronization SQL."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівнює DDL об'єктів схеми з цільовою схемою (також на іншому з'єднанні); список відмінностей, попередній перегляд і SQL вирівнювання."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara el DDL de los objetos del esquema con el esquema de destino (también en otra conexión); lista de diferencias, vista previa y SQL de alineación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht die DDL der Schemaobjekte mit dem Zielschema (auch auf einer anderen Verbindung); Unterschiedsliste, Vorschau und Abgleich-SQL."
          }
        }
      }
    },
    "Porównuje bieżący plan okna z poprzednim (albo z planem drugiego okna planu): operacje, koszty, kardynalność, kolejność." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares the window's current plan with the previous one (or with the plan of a second plan window): operations, costs, cardinality, order."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівнює поточний план вікна з попереднім (або з планом іншого Explain Plan Window): операції, вартості, кардинальність, порядок."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara el plan actual de la ventana con el anterior (o con el plan de otra Explain Plan Window): operaciones, costes, cardinalidad, orden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht den aktuellen Plan des Fensters mit dem vorherigen (oder mit dem Plan eines zweiten Explain Plan Window): Operationen, Kosten, Kardinalität, Reihenfolge."
          }
        }
      }
    },
    "Porównuje bieżącą kartę wyników z drugą kartą okna (przypiętą albo sąsiednią), z podświetleniem różnic." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares the current result tab with another tab of the window (pinned or adjacent), highlighting differences."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівнює поточну вкладку результатів з іншою вкладкою вікна (закріпленою або сусідньою) з підсвічуванням відмінностей."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara la pestaña de resultados actual con otra pestaña de la ventana (fijada o contigua), resaltando las diferencias."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht den aktuellen Ergebnis-Tab mit einem zweiten Tab des Fensters (angeheftet oder benachbart), mit hervorgehobenen Unterschieden."
          }
        }
      }
    },
    "Porównuje czas ostatniej zmiany obiektów okna programu w bazie z chwilą wczytania albo kompilacji." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares the last-modified time of the Program Window's objects in the database with the time of loading or compilation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht den Zeitpunkt der letzten Änderung der Objekte des Program Window in der Datenbank mit dem Zeitpunkt des Ladens oder Kompilierens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara la hora de la última modificación de los objetos del Program Window en la base de datos con el momento de la carga o la compilación."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівнює час останньої зміни об’єктів Program Window у базі даних із моментом завантаження або компіляції."
          }
        }
      }
    },
    "Porównuje dane tabel ze schematem docelowym (także na innym połączeniu) po kluczu głównym; skrypt albo aktualizacja celu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares table data with the target schema (also on another connection) by primary key; script or target update."
          }
