    "DBMS_AQADM.START_QUEUE: włącza kolejkowanie i odbieranie wiadomości kolejki AQ." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DBMS_AQADM.START_QUEUE: enables enqueuing and dequeuing of AQ queue messages."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DBMS_AQADM.START_QUEUE: aktiviert Einreihen und Abrufen von Nachrichten der AQ-Warteschlange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DBMS_AQADM.START_QUEUE: activa el encolado y desencolado de mensajes de la cola AQ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DBMS_AQADM.START_QUEUE: вмикає постановку й отримання повідомлень черги AQ."
          }
        }
      }
    },
    "DBMS_AQADM.STOP_QUEUE: wyłącza kolejkowanie i odbieranie wiadomości kolejki AQ (czeka na bieżące transakcje)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DBMS_AQADM.STOP_QUEUE: disables enqueuing and dequeuing of AQ queue messages (waits for current transactions)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DBMS_AQADM.STOP_QUEUE: deaktiviert Einreihen und Abrufen von Nachrichten der AQ-Warteschlange (wartet auf laufende Transaktionen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DBMS_AQADM.STOP_QUEUE: desactiva el encolado y desencolado de mensajes de la cola AQ (espera a las transacciones en curso)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DBMS_AQADM.STOP_QUEUE: вимикає постановку й отримання повідомлень черги AQ (чекає на поточні транзакції)."
          }
        }
      }
    },
