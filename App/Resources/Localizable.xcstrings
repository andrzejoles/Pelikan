    "Klucz serwera inny niż zapamiętany w known_hosts — możliwa podmiana serwera; sprawdź z administratorem" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server key differs from the one stored in known_hosts — the server may have been replaced; check with the administrator"
