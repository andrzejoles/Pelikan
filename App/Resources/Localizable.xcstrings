    "Przenosi kursor na pierwszy niebiały znak linii, a ponownie — na początek linii." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the cursor to the first non-blank character of the line, and again — to the start of the line."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt den Cursor auf das erste nicht leere Zeichen der Zeile, erneut — an den Zeilenanfang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el cursor al primer carácter no blanco de la línea y, de nuevo, al inicio de la línea."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщує курсор на перший непробільний символ рядка, а повторно — на початок рядка."
          }
        }
      }
    },
    "Przenosi plik albo katalog do Kosza (po potwierdzeniu); otwarte okno pliku zostaje jako okno bez pliku." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves the file or directory to the Trash (after confirmation); an open window of the file remains as a window without a file."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщує файл або каталог у Кошик (після підтвердження); відкрите вікно файлу залишається як вікно без файлу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada el archivo o directorio a la Papelera (tras confirmación); la ventana abierta del archivo queda como ventana sin archivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
