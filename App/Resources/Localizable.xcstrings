    "Reguły user@baza (* i ?) mają pierwszeństwo przed kolorem połączenia i środowiska; dotyczą kart, listy okien i tła." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "user@database rules (* and ?) take precedence over the connection and environment color; they apply to tabs, the window list and the background."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeln user@Datenbank (* und ?) haben Vorrang vor der Farbe der Verbindung und Umgebung; sie gelten für Tabs, Fensterliste und Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas usuario@base (* y ?) tienen prioridad sobre el color de la conexión y del entorno; se aplican a pestañas, lista de ventanas y fondo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила user@база (* і ?) мають перевагу над кольором підключення та середовища; стосуються вкладок, списку вікон і тла."
          }
        }
      }
    },
