          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає курсор у рядку вище (у тому самому стовпці); введення потрапляє до всіх курсорів."
          }
        }
      }
    },
    "Dodaje lub usuwa -- na początku zaznaczonych linii." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds or removes -- at the start of the selected lines."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає або видаляє -- на початку виділених рядків."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade o quita -- al principio de las líneas seleccionadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt -- am Anfang der ausgewählten Zeilen hinzu oder entfernt es."
          }
        }
      }
    },
    "Dodaje na końcu okna programu nową jednostkę (z szablonu albo z tekstu) jako kolejną kartę." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appends a new unit (from a template or text) to the end of the program window as another tab."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt am Ende des Programmfensters eine neue Einheit (aus einer Vorlage oder einem Text) als weitere Registerkarte hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade al final de la ventana de programa una nueva unidad (desde una plantilla o un texto) como otra pestaña."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає в кінець вікна програми нову одиницю (із шаблону або тексту) як ще одну вкладку."
          }
        }
      }
    },
    "Dodaje notatkę na diagramie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a note to the diagram."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає нотатку на діаграму."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una nota al diagrama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt dem Diagramm eine Notiz hinzu."
          }
        }
