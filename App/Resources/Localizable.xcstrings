        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівнює дані таблиць із цільовою схемою (також на іншому з'єднанні) за первинним ключем; скрипт або оновлення цілі."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara los datos de las tablas con el esquema de destino (también en otra conexión) por clave primaria; script o actualización del destino."
          }
        },
        "de" : {
          "stringUnit" : {
