    "Sesja %@ zostanie zakończona w bazie (ALTER SYSTEM KILL SESSION). Niezatwierdzone zmiany tej sesji przepadną." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session %@ will be terminated in the database (ALTER SYSTEM KILL SESSION). Uncommitted changes of this session will be lost."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzung %@ wird in der Datenbank beendet (ALTER SYSTEM KILL SESSION). Nicht festgeschriebene Änderungen dieser Sitzung gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión %@ se finalizará en la base de datos (ALTER SYSTEM KILL SESSION). Se perderán los cambios no confirmados de esta sesión."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс %@ буде завершено в базі даних (ALTER SYSTEM KILL SESSION). Незафіксовані зміни цього сеансу буде втрачено."
          }
        }
      }
    },
