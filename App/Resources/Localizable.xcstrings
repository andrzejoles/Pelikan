    "Zamyka okna przypięte do połączenia (z pytaniem o niezapisane zmiany i otwarte transakcje)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes the windows pinned to the connection (asking about unsaved changes and open transactions)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt die an die Verbindung gebundenen Fenster (mit Rückfrage bei ungesicherten Änderungen und offenen Transaktionen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra las ventanas vinculadas a la conexión (preguntando por cambios sin guardar y transacciones abiertas)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закриває вікна, прив'язані до з'єднання (з питанням про незбережені зміни й відкриті транзакції)."
          }
        }
      }
    },
    "Zamyka okno o podanym identyfikatorze (z pytaniami o zapis i transakcję)." : {
