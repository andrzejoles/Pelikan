    "Niezatwierdzona transakcja tej sesji zostanie wycofana." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The uncommitted transaction of this session will be rolled back."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незафіксовану транзакцію цього сеансу буде відкочено."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se revertirá la transacción sin confirmar de esta sesión."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nicht festgeschriebene Transaktion dieser Sitzung wird zurückgerollt."
          }
        }
