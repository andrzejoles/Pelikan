        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ сервера відрізняється від запам'ятованого в known_hosts — можлива підміна сервера; перевірте з адміністратором"
          }
        },
        "es" : {
